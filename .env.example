# Copy to .env (gitignored) and fill in as needed. Everything here is OPTIONAL —
# the reconciliation engine runs against local files with no credentials.

# Raises the GitHub code-search rate limit used by scripts/fetch_route.sh
# (10/min anonymous -> 30/min authenticated). A read-only public-repo token suffices.
GITHUB_TOKEN=

# Override the local mirror of the GEM route repo.
# Default: the sibling ../GOIT-GGIT-pipeline-routes next to this repo.
# GEM_ROUTES_REPO=/Users/you/path/to/GOIT-GGIT-pipeline-routes

# Override the local root of scraped reference datasets (GulfPub, etc.).
# Default: the sibling ../GOIT-GGIT-scraping next to this repo.
# GEM_SCRAPING_REPO=/Users/you/path/to/GOIT-GGIT-scraping

# GEM Project Database MCP (only if you use the live project DB; not needed for reconciliation).
# Django sessionid; rotates ~every 2 weeks.
# GEM_SESSION_COOKIE=
